PORT=3001

GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/caminho/para/service-account.json

GOOGLE_CALENDAR_CAROL=seu_calendar_id_aqui
GOOGLE_CALENDAR_MALU=seu_calendar_id_aqui
# --- Proteção da reserva (todas opcionais) ---
# Origens que podem chamar a API, separadas por vírgula. Vazio = qualquer origem.
CORS_ORIGINS=https://studio-cm.vercel.app
# Quantos proxies confiar para descobrir o IP real (1 na maioria das hospedagens).
TRUST_PROXY=1
BOOKING_RATE_LIMIT_PER_HOUR=5
BOOKING_RATE_LIMIT_PER_PHONE_PER_DAY=4
BOOKING_MAX_PENDING_PER_PHONE=2
BOOKING_MAX_DAYS_AHEAD=120
AVAILABILITY_RATE_LIMIT_PER_MINUTE=120

# Minutos que a pré-reserva segura o horário sem sinal. Padrão 1440 (24h,
# temporário até o Pix automático); 0 desliga. Com Pix automático: 10.
# A profissional confirma tirando "PRÉ-RESERVA" do título do evento.
# Pré-reservas criadas antes desta versão nunca expiram automaticamente.
PREBOOKING_TTL_MINUTES=1440
# true = só registra no log o que expiraria, sem mexer na agenda.
PREBOOKING_EXPIRY_DRY_RUN=false

# ── StudioCM 2.0: banco e Pix automático (ver docs/pix.md) ──
# off (padrão, site como hoje) | fake (simulado) | sandbox (Mercado Pago TESTE) | live
PIX_MODE=off
# Produção só com autorização explícita:
# PIX_LIVE_CONFIRMED=sim
DATABASE_URL=postgres://usuario:senha@host:5432/studiocm
# URL pública desta API, usada para montar a URL do webhook de cada profissional
PUBLIC_API_URL=https://sua-api.exemplo
# Segredo das tarefas agendadas (/api/jobs/*)
CRON_SECRET=
# Mercado Pago: uma conta por profissional (credenciais de TESTE no sandbox)
MP_ACCESS_TOKEN_MALU=
MP_WEBHOOK_SECRET_MALU=
MP_ACCESS_TOKEN_CAROL=
MP_WEBHOOK_SECRET_CAROL=
# A cliente não informa e-mail. E-mail técnico do pagador exigido pela API:
# domínio do estúdio (gera reserva-<id>@dominio) ou um endereço fixo.
MP_PAYER_EMAIL_DOMAIN=
MP_PAYER_EMAIL=
# Só para testes automatizados (banco descartável, o nome precisa conter "test")
TEST_DATABASE_URL=
