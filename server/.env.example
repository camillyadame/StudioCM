PORT=3001

GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/caminho/para/service-account.json

GOOGLE_CALENDAR_CAROL=seu_calendar_id_aqui
GOOGLE_CALENDAR_MALU=seu_calendar_id_aqui
# --- Proteção da reserva (todas opcionais) ---
# Origens que podem chamar a API, separadas por vírgula. Vazio = qualquer origem.
CORS_ORIGINS=https://studio-cm.vercel.app
# Quantos proxies confiar para descobrir o IP real (1 na maioria das hospedagens).
TRUST_PROXY=1
BOOKING_RATE_LIMIT_PER_HOUR=5
BOOKING_RATE_LIMIT_PER_PHONE_PER_DAY=4
BOOKING_MAX_PENDING_PER_PHONE=2
BOOKING_MAX_DAYS_AHEAD=120
AVAILABILITY_RATE_LIMIT_PER_MINUTE=120

# Minutos que a pré-reserva segura o horário sem sinal. Padrão 10; 0 desliga.
# A profissional confirma tirando "PRÉ-RESERVA" do título do evento.
# Pré-reservas criadas antes desta versão nunca expiram automaticamente.
PREBOOKING_TTL_MINUTES=10
# true = só registra no log o que expiraria, sem mexer na agenda.
PREBOOKING_EXPIRY_DRY_RUN=false
